# High-frequency IWRAM entries (runtime-copied code). Declared so the
# dispatch table resolves them instead of bridging the interpreter.
# Verified against IWRAM dump + ROM byte-match (scripts/match_iwram_to_rom.py).
[[code_copy]]
runtime_start = 0x03000C60
source_start = 0x08037500
size = 896
name = "iwram_copy_03000c60"
note = "Thumb routine copied to IWRAM; matched 896 bytes vs ROM 0x08037500"

[[code_copy]]
runtime_start = 0x03002490
source_start = 0x080000FC
size = 1024
name = "iwram_copy_03002490"
note = "ARM IRQ/trampoline block copied to IWRAM; 1024 bytes matched. 0x0300258C is an interior entry."

